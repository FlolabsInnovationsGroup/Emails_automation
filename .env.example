# ── Copy this file to .env and fill in real values ──────────────────────────

# ── Email account (used for both IMAP reading and SMTP sending) ─────────────
EMAIL_ADDRESS=you@example.com
# For Gmail with 2FA: create an App Password at https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=your_app_password_here
SENDER_NAME=Your Name

# ── IMAP (incoming) ─────────────────────────────────────────────────────────
IMAP_HOST=imap.gmail.com    # Outlook: outlook.office365.com
IMAP_PORT=993
IMAP_USE_SSL=true
IMAP_MAILBOX=INBOX

# ── SMTP (outgoing) ─────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com    # Outlook: smtp.office365.com
SMTP_PORT=587
SMTP_USE_TLS=true

# ── LLM ─────────────────────────────────────────────────────────────────────
LLM_PROVIDER=anthropic      # "anthropic" | "openai"
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...       # only needed if LLM_PROVIDER=openai

# Override the model (optional — leave blank to use provider default)
# LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7

# ── Behaviour ────────────────────────────────────────────────────────────────
# "queue" → save to outbox/ for human review before sending
# "auto"  → send replies immediately
REPLY_MODE=queue

# Maximum emails to process per run (0 = unlimited)
MAX_EMAILS=10

# Mark processed emails as read in the inbox
MARK_AS_READ=true

# Retry transient failures (IMAP / SMTP / LLM calls)
RETRY_ATTEMPTS=3
RETRY_DELAY_SECONDS=2.0

# Optional: path to a plain-text file that overrides the built-in system prompt
# SYSTEM_PROMPT_FILE=my_prompt.txt

# ── Gmail API (for funnel label management) ───────────────────────────────────
# Download credentials.json from Google Cloud Console (OAuth 2.0 Desktop app)
# See README.md → "Funnel Labels (Gmail Stage Tracking)" for full setup steps.
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
GMAIL_LABELS_ENABLED=true

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR
# LOG_FILE=logs/automation.log   # uncomment to write logs to a file
